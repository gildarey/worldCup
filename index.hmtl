<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FIFA World Cup 2026</title>
<style>
:root{
  --bg:#020611;--s1:#080E1F;--s2:#0D1630;--s3:#14203E;
  --bd:rgba(255,255,255,.06);--bd2:rgba(255,255,255,.12);
  --red:#C8102E;--gold:#F5B800;--green:#00C261;--orange:#E87820;
  --white:#F0EDE8;--grey:#4A6585;--mono:'Courier New',monospace;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--white);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;min-height:100vh;}

/* ─ HEADER ─ */
.hdr{
  background:linear-gradient(135deg,#0A0418 0%,#120820 40%,#0B1230 100%);
  border-bottom:3px solid var(--red);
  padding:20px 20px 16px;text-align:center;
  position:sticky;top:0;z-index:200;
  overflow:hidden;
}
.hdr::before{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(
    -55deg,transparent,transparent 18px,
    rgba(200,16,46,.04) 18px,rgba(200,16,46,.04) 36px
  );pointer-events:none;
}
.hdr-top{font-size:9px;letter-spacing:6px;color:var(--red);text-transform:uppercase;margin-bottom:4px;position:relative;}
.hdr-title{font-size:26px;font-weight:900;letter-spacing:2px;line-height:1;position:relative;}
.hdr-title em{color:var(--gold);font-style:normal;}
.hdr-hosts{font-size:9px;color:var(--grey);letter-spacing:3px;margin-top:5px;position:relative;}
.hdr-badge{display:inline-block;background:var(--red);color:#fff;font-size:8px;font-weight:800;letter-spacing:2px;padding:3px 8px;border-radius:2px;margin-top:6px;position:relative;}

/* ─ TABS ─ */
.tabs{display:flex;background:var(--s1);border-bottom:1px solid var(--bd);position:sticky;top:88px;z-index:199;overflow-x:auto;}
.tab{padding:13px 24px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--grey);cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;transition:color .15s,border-color .15s;user-select:none;}
.tab:hover{color:var(--white);}
.tab.active{color:var(--gold);border-bottom-color:var(--gold);}
.panel{display:none;}.panel.active{display:block;}
.wrap{max-width:1400px;margin:0 auto;padding:20px 16px;}

/* ─ GROUPS ─ */
.groups-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
@media(max-width:1200px){.groups-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:850px){.groups-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:520px){.groups-grid{grid-template-columns:1fr;}}

.gcard{background:var(--s1);border:1px solid var(--bd);border-radius:4px;overflow:hidden;position:relative;}
.gcard-hd{padding:10px 14px 8px;position:relative;overflow:hidden;border-bottom:1px solid var(--bd);}
.gcard-hd::after{
  content:attr(data-grp);position:absolute;right:-4px;top:-10px;
  font-size:72px;font-weight:900;color:rgba(200,16,46,.08);line-height:1;
  pointer-events:none;letter-spacing:-4px;
}
.gcard-lbl{font-size:9px;font-weight:800;letter-spacing:3px;color:var(--red);text-transform:uppercase;}

.gtbl{width:100%;border-collapse:collapse;}
.gtbl th{font-size:8px;letter-spacing:1px;color:var(--grey);text-transform:uppercase;padding:6px 6px;text-align:center;border-bottom:1px solid var(--bd);background:rgba(0,0,0,.2);}
.gtbl th:first-child{text-align:left;padding-left:10px;width:48%;}
.gtbl td{padding:8px 6px;text-align:center;font-size:11px;border-bottom:1px solid rgba(255,255,255,.04);}
.gtbl td:first-child{text-align:left;padding-left:0;}
.gtbl tr:last-child td{border-bottom:none;}
.gtbl tr.q1 td:first-child,.gtbl tr.q2 td:first-child{border-left:3px solid var(--green);}
.gtbl tr.q3 td:first-child{border-left:3px solid var(--orange);}
.tc{display:flex;align-items:center;gap:6px;padding-left:4px;}
.fl{font-size:15px;line-height:1;flex-shrink:0;}
.tn{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100px;}
.pts{font-weight:900;color:var(--gold);}
.gdp{color:var(--green);}.gdn{color:#e74c3c;}

/* ─ MATCHES TOOLBAR ─ */
.toolbar{
  display:flex;flex-wrap:wrap;gap:8px;align-items:center;
  padding:0 0 16px;border-bottom:1px solid var(--bd);margin-bottom:16px;
}
.pf{display:flex;gap:5px;flex-wrap:wrap;}
.pfbtn{
  padding:6px 13px;font-size:10px;font-weight:700;letter-spacing:1px;
  text-transform:uppercase;background:var(--s2);border:1px solid var(--bd2);
  color:var(--grey);cursor:pointer;border-radius:2px;transition:all .15s;
}
.pfbtn:hover{color:var(--white);}
.pfbtn.on{background:var(--red);color:#fff;border-color:var(--red);}
.fsel{
  padding:6px 10px;background:var(--s2);border:1px solid var(--bd2);
  color:var(--white);font-size:10px;border-radius:2px;cursor:pointer;
}
.fsel option{background:var(--s1);}
.export-btn{
  margin-left:auto;padding:6px 14px;background:transparent;
  border:1px solid var(--bd2);color:var(--grey);font-size:10px;
  font-weight:700;letter-spacing:1px;text-transform:uppercase;
  cursor:pointer;border-radius:2px;display:flex;align-items:center;gap:6px;
  transition:all .15s;
}
.export-btn:hover{color:var(--white);border-color:var(--white);}
.export-btn svg{flex-shrink:0;}

/* ─ DATE HEADER ─ */
.dh{
  font-size:9px;font-weight:800;letter-spacing:3px;text-transform:uppercase;
  color:var(--grey);padding:12px 0 8px;border-bottom:1px solid var(--bd);
  margin-bottom:8px;display:flex;align-items:center;gap:10px;
}
.dh-count{font-size:8px;color:var(--bd2);font-weight:400;letter-spacing:1px;}

/* ─ MATCH GRID (2 per row) ─ */
.mday-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:8px;}
@media(max-width:700px){.mday-grid{grid-template-columns:1fr;}}

/* ─ MATCH CARD ─ */
.mcard{
  background:var(--s1);border:1px solid var(--bd);border-radius:4px;
  overflow:hidden;transition:border-color .15s;
  border-left:3px solid var(--bd);
}
.mcard:hover{border-color:var(--bd2);}
.mcard.played{border-left-color:var(--gold);}
.mcard.today{border-left-color:var(--red);animation:pulse-border 2s infinite;}
@keyframes pulse-border{0%,100%{border-left-color:var(--red);}50%{border-left-color:rgba(200,16,46,.3);}}

.mcard-hd{
  background:var(--s2);padding:7px 10px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--bd);
}
.mc-grp{font-size:9px;font-weight:800;letter-spacing:2px;color:var(--red);text-transform:uppercase;}
.mc-time{font-size:15px;font-weight:900;font-family:var(--mono);color:var(--gold);line-height:1;}
.mc-tz{font-size:8px;color:var(--grey);margin-top:1px;letter-spacing:1px;}
.mc-date{font-size:8px;color:var(--grey);text-align:right;letter-spacing:1px;}

.mcard-body{padding:10px 10px 8px;}
.score-row{display:flex;align-items:center;justify-content:space-between;gap:6px;}
.team-side{display:flex;align-items:center;gap:7px;flex:1;min-width:0;}
.team-side.r{flex-direction:row-reverse;justify-content:flex-start;}
.team-side .fl{font-size:20px;}
.team-side .tn2{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:90px;}

.score-center{flex-shrink:0;text-align:center;min-width:80px;}
.score-val{font-size:24px;font-weight:900;font-family:var(--mono);color:var(--white);letter-spacing:4px;}
.score-sep-d{color:var(--grey);font-size:16px;}
.score-vs{font-size:10px;font-weight:800;letter-spacing:2px;color:var(--grey);text-transform:uppercase;}
.score-inputs{display:flex;align-items:center;gap:4px;}
.sin{width:36px;height:36px;background:var(--s3);border:1px solid var(--bd2);color:var(--white);text-align:center;font-size:16px;font-weight:900;font-family:var(--mono);border-radius:3px;}
.sin:focus{outline:none;border-color:var(--gold);background:var(--s2);}
.sin-sep{font-size:18px;font-weight:900;color:var(--grey);}

.mcard-foot{
  padding:7px 10px;border-top:1px solid var(--bd);
  display:flex;align-items:center;justify-content:space-between;gap:6px;
}
.venue-s{font-size:9px;color:var(--grey);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px;}

/* ─ CAL BUTTONS ─ */
.cal-btns{display:flex;gap:5px;align-items:center;flex-shrink:0;}
.cbtn{
  display:flex;align-items:center;gap:4px;
  padding:4px 8px;border:1px solid var(--bd2);border-radius:2px;
  font-size:9px;font-weight:700;letter-spacing:.5px;color:var(--grey);
  cursor:pointer;background:transparent;transition:all .15s;white-space:nowrap;
}
.cbtn:hover{color:var(--white);border-color:var(--white);}
.cbtn.gcal:hover{color:#4285F4;border-color:#4285F4;}
.cbtn.acal:hover{color:#A2AAAD;border-color:#A2AAAD;}
.save-inline{
  padding:4px 9px;background:var(--gold);color:#000;
  border:none;border-radius:2px;font-size:9px;font-weight:800;
  letter-spacing:1px;text-transform:uppercase;cursor:pointer;
}
.save-inline:hover{background:#FFD040;}
.edit-s{
  padding:3px 7px;background:transparent;color:var(--grey);
  border:1px solid var(--bd);border-radius:2px;font-size:8px;
  font-weight:700;letter-spacing:1px;cursor:pointer;
}
.edit-s:hover{color:var(--white);}
.played-s{font-size:8px;color:var(--green);letter-spacing:1px;text-transform:uppercase;}

/* ─ LEGEND ─ */
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;}
.lg{display:flex;align-items:center;gap:5px;font-size:9px;color:var(--grey);letter-spacing:1px;text-transform:uppercase;}
.ld{width:10px;height:3px;border-radius:1px;}
.lg-g{background:var(--green);}.lg-o{background:var(--orange);}.lg-gld{background:var(--gold);}.lg-r{background:var(--red);}

/* ─ KNOCKOUTS ─ */
.ko-rnd{margin-bottom:32px;}
.ko-rnd-hd{
  font-size:10px;font-weight:800;letter-spacing:4px;text-transform:uppercase;
  color:var(--red);padding-bottom:10px;border-bottom:2px solid var(--red);
  margin-bottom:14px;display:flex;align-items:baseline;gap:12px;
}
.ko-rnd-sub{color:var(--grey);font-size:9px;font-weight:400;letter-spacing:1px;}
.ko-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px;}
.kocard{background:var(--s1);border:1px solid var(--bd);border-radius:4px;overflow:hidden;}
.kocard-hd{background:var(--s2);padding:6px 10px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--bd);}
.ko-id{font-size:8px;font-weight:800;letter-spacing:2px;color:var(--grey);text-transform:uppercase;}
.ko-meta{font-size:8px;color:var(--grey);text-align:right;line-height:1.5;}
.ko-body{padding:10px;}
.ko-tr{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04);}
.ko-tr:last-child{border-bottom:none;}
.ko-tl{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;}
.ko-sc{font-size:18px;font-weight:900;font-family:var(--mono);min-width:20px;text-align:right;color:var(--gold);}
.ko-slot{font-size:11px;font-weight:700;color:var(--grey);}
.ko-tr.win .ko-tl{color:var(--gold);}
.ko-tr.los{opacity:.4;}
.ko-foot{padding:7px 10px;border-top:1px solid var(--bd);display:flex;align-items:center;gap:6px;}
.ko-sbtn{padding:5px 10px;background:var(--gold);color:#000;border:none;border-radius:2px;font-size:9px;font-weight:800;cursor:pointer;letter-spacing:1px;}
.ko-ebtn{padding:4px 8px;background:transparent;color:var(--grey);border:1px solid var(--bd);border-radius:2px;font-size:8px;font-weight:700;cursor:pointer;margin-left:auto;}
.ko-ebtn:hover{color:var(--white);}

/* ─ MISC ─ */
.empty{text-align:center;padding:48px 20px;color:var(--grey);font-size:12px;letter-spacing:1px;}
.final-card{border:2px solid var(--gold) !important;}
.final-card .kocard-hd{background:rgba(245,184,0,.08);}
</style>
</head>
<body>

<header class="hdr">
  <div class="hdr-top">FIFA</div>
  <div class="hdr-title">WORLD CUP <em>2026</em></div>
  <div class="hdr-hosts">USA &nbsp;·&nbsp; MEXICO &nbsp;·&nbsp; CANADA &nbsp;·&nbsp; 104 MATCHES &nbsp;·&nbsp; ALL TIMES CEST (Stockholm)</div>
</header>

<nav class="tabs">
  <div class="tab active" onclick="switchTab('groups',this)">Groups</div>
  <div class="tab" onclick="switchTab('matches',this)">Matches</div>
  <div class="tab" onclick="switchTab('knockouts',this)">Knockouts</div>
</nav>

<div id="panel-groups" class="panel active">
  <div class="wrap">
    <div class="legend">
      <div class="lg"><div class="ld lg-g"></div>Qualified (R32)</div>
      <div class="lg"><div class="ld lg-o"></div>Best 3rd (potential)</div>
      <div class="lg"><div class="ld lg-gld"></div>Match played</div>
      <div class="lg"><div class="ld lg-r"></div>Today</div>
    </div>
    <div class="groups-grid" id="groupsGrid"></div>
  </div>
</div>

<div id="panel-matches" class="panel">
  <div class="wrap">
    <div class="toolbar">
      <div class="pf">
        <div class="pfbtn" data-p="yesterday" onclick="setPeriod(this)">Yesterday</div>
        <div class="pfbtn" data-p="today" onclick="setPeriod(this)">Today</div>
        <div class="pfbtn" data-p="tomorrow" onclick="setPeriod(this)">Tomorrow</div>
        <div class="pfbtn on" data-p="thisAndNext" onclick="setPeriod(this)">This &amp; Next Week</div>
        <div class="pfbtn" data-p="all" onclick="setPeriod(this)">All Matches</div>
      </div>
      <select class="fsel" id="teamFilter" onchange="renderMatches()"><option value="">All Teams</option></select>
      <select class="fsel" id="groupFilter" onchange="renderMatches()">
        <option value="">All Groups</option>
        <option>A</option><option>B</option><option>C</option><option>D</option>
        <option>E</option><option>F</option><option>G</option><option>H</option>
        <option>I</option><option>J</option><option>K</option><option>L</option>
      </select>
      <button class="export-btn" onclick="exportVisible()">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 17l4 4 4-4M12 12v9M20.88 18.09A5 5 0 0018 9h-1.26A8 8 0 103 16.29"/></svg>
        Export visible .ics
      </button>
    </div>
    <div id="matchList"></div>
  </div>
</div>

<div id="panel-knockouts" class="panel">
  <div class="wrap">
    <div id="koPanel"></div>
  </div>
</div>

<script>
/* ──── FLAGS ──── */
const F={
  'Mexico':'🇲🇽','South Africa':'🇿🇦','South Korea':'🇰🇷','Czech Republic':'🇨🇿',
  'Canada':'🇨🇦','Bosnia and Herzegovina':'🇧🇦','Qatar':'🇶🇦','Switzerland':'🇨🇭',
  'Brazil':'🇧🇷','Morocco':'🇲🇦','Haiti':'🇭🇹','Scotland':'🏴󠁧󠁢󠁳󠁣󠁴󠁿',
  'United States':'🇺🇸','Paraguay':'🇵🇾','Australia':'🇦🇺','Turkey':'🇹🇷',
  'Germany':'🇩🇪','Curacao':'🇨🇼','Ivory Coast':'🇨🇮','Ecuador':'🇪🇨',
  'Netherlands':'🇳🇱','Japan':'🇯🇵','Sweden':'🇸🇪','Tunisia':'🇹🇳',
  'Belgium':'🇧🇪','Egypt':'🇪🇬','Iran':'🇮🇷','New Zealand':'🇳🇿',
  'Spain':'🇪🇸','Cape Verde':'🇨🇻','Saudi Arabia':'🇸🇦','Uruguay':'🇺🇾',
  'France':'🇫🇷','Senegal':'🇸🇳','Iraq':'🇮🇶','Norway':'🇳🇴',
  'Argentina':'🇦🇷','Algeria':'🇩🇿','Austria':'🇦🇹','Jordan':'🇯🇴',
  'Portugal':'🇵🇹','DR Congo':'🇨🇩','Uzbekistan':'🇺🇿','Colombia':'🇨🇴',
  'England':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','Croatia':'🇭🇷','Ghana':'🇬🇭','Panama':'🇵🇦'
};
/* Short names for long teams */
const SN={'Bosnia and Herzegovina':'Bosnia-Herz.','New Zealand':'N. Zealand','Saudi Arabia':'Saudi Arabia','Ivory Coast':'Ivory Coast','Czech Republic':'Czech Rep.'};
function sn(t){return SN[t]||t;}

/* ──── GROUPS ──── */
const GRP={
  A:['Mexico','South Africa','South Korea','Czech Republic'],
  B:['Canada','Bosnia and Herzegovina','Qatar','Switzerland'],
  C:['Brazil','Morocco','Haiti','Scotland'],
  D:['United States','Paraguay','Australia','Turkey'],
  E:['Germany','Curacao','Ivory Coast','Ecuador'],
  F:['Netherlands','Japan','Sweden','Tunisia'],
  G:['Belgium','Egypt','Iran','New Zealand'],
  H:['Spain','Cape Verde','Saudi Arabia','Uruguay'],
  I:['France','Senegal','Iraq','Norway'],
  J:['Argentina','Algeria','Austria','Jordan'],
  K:['Portugal','DR Congo','Uzbekistan','Colombia'],
  L:['England','Croatia','Ghana','Panama']
};

/* ──── GROUP STAGE MATCHES (72) — CEST ──── */
const GM=[
  {id:'m1', d:'2026-06-11',t:'21:00',t1:'Mexico',           t2:'South Africa',           g:'A',v:'Estadio Azteca, Mexico City'},
  {id:'m2', d:'2026-06-12',t:'04:00',t1:'South Korea',       t2:'Czech Republic',         g:'A',v:'Estadio Akron, Guadalajara'},
  {id:'m3', d:'2026-06-18',t:'18:00',t1:'Czech Republic',    t2:'South Africa',           g:'A',v:'Mercedes-Benz Stadium, Atlanta'},
  {id:'m4', d:'2026-06-19',t:'03:00',t1:'Mexico',            t2:'South Korea',            g:'A',v:'Estadio Akron, Guadalajara'},
  {id:'m5', d:'2026-06-25',t:'03:00',t1:'Czech Republic',    t2:'Mexico',                 g:'A',v:'Estadio Azteca, Mexico City'},
  {id:'m6', d:'2026-06-25',t:'03:00',t1:'South Africa',      t2:'South Korea',            g:'A',v:'Estadio Tecnológico, Monterrey'},
  {id:'m7', d:'2026-06-12',t:'21:00',t1:'Canada',            t2:'Bosnia and Herzegovina', g:'B',v:'BMO Field, Toronto'},
  {id:'m8', d:'2026-06-13',t:'21:00',t1:'Qatar',             t2:'Switzerland',            g:'B',v:"Levi's Stadium, Santa Clara"},
  {id:'m9', d:'2026-06-18',t:'21:00',t1:'Switzerland',       t2:'Bosnia and Herzegovina', g:'B',v:'SoFi Stadium, Los Angeles'},
  {id:'m10',d:'2026-06-19',t:'00:00',t1:'Canada',            t2:'Qatar',                  g:'B',v:'BC Place, Vancouver'},
  {id:'m11',d:'2026-06-24',t:'21:00',t1:'Switzerland',       t2:'Canada',                 g:'B',v:'BC Place, Vancouver'},
  {id:'m12',d:'2026-06-24',t:'21:00',t1:'Bosnia and Herzegovina',t2:'Qatar',              g:'B',v:'Lumen Field, Seattle'},
  {id:'m13',d:'2026-06-14',t:'00:00',t1:'Brazil',            t2:'Morocco',                g:'C',v:'MetLife Stadium, East Rutherford'},
  {id:'m14',d:'2026-06-14',t:'03:00',t1:'Haiti',             t2:'Scotland',               g:'C',v:'Gillette Stadium, Foxborough'},
  {id:'m15',d:'2026-06-20',t:'00:00',t1:'Scotland',          t2:'Morocco',                g:'C',v:'Gillette Stadium, Foxborough'},
  {id:'m16',d:'2026-06-20',t:'03:00',t1:'Brazil',            t2:'Haiti',                  g:'C',v:'Lincoln Financial Field, Philadelphia'},
  {id:'m17',d:'2026-06-25',t:'00:00',t1:'Brazil',            t2:'Scotland',               g:'C',v:'Hard Rock Stadium, Miami'},
  {id:'m18',d:'2026-06-25',t:'00:00',t1:'Morocco',           t2:'Haiti',                  g:'C',v:'Mercedes-Benz Stadium, Atlanta'},
  {id:'m19',d:'2026-06-13',t:'03:00',t1:'United States',     t2:'Paraguay',               g:'D',v:'SoFi Stadium, Inglewood'},
  {id:'m20',d:'2026-06-13',t:'06:00',t1:'Australia',         t2:'Turkey',                 g:'D',v:'BC Place, Vancouver'},
  {id:'m21',d:'2026-06-19',t:'21:00',t1:'United States',     t2:'Australia',              g:'D',v:'Lumen Field, Seattle'},
  {id:'m22',d:'2026-06-20',t:'06:00',t1:'Turkey',            t2:'Paraguay',               g:'D',v:"Levi's Stadium, Santa Clara"},
  {id:'m23',d:'2026-06-26',t:'04:00',t1:'Turkey',            t2:'United States',          g:'D',v:'SoFi Stadium, Los Angeles'},
  {id:'m24',d:'2026-06-26',t:'04:00',t1:'Paraguay',          t2:'Australia',              g:'D',v:"Levi's Stadium, Santa Clara"},
  {id:'m25',d:'2026-06-14',t:'19:00',t1:'Germany',           t2:'Curacao',                g:'E',v:'NRG Stadium, Houston'},
  {id:'m26',d:'2026-06-15',t:'01:00',t1:'Ivory Coast',       t2:'Ecuador',                g:'E',v:'Lincoln Financial Field, Philadelphia'},
