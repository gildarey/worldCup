const ALL_KO=[...R32,...R16,...QF,...SF,...THIRD,...FINAL];

/* ──── STATE ──── */
const SK='wc2026_v4';
let RES={},period='thisAndNext',editG={},editK={};
function load(){try{const s=localStorage.getItem(SK);if(s)RES=JSON.parse(s);}catch(e){}}
function persist(){localStorage.setItem(SK,JSON.stringify(RES));}

/* ──── STANDINGS ──── */
function stnd(grp){
  const t={};GRP[grp].forEach(n=>t[n]={p:0,w:0,d:0,l:0,gf:0,ga:0,pts:0});
  GM.filter(m=>m.g===grp&&RES[m.id]).forEach(m=>{
    const r=RES[m.id];
    t[m.t1].p++;t[m.t2].p++;t[m.t1].gf+=r.g1;t[m.t1].ga+=r.g2;t[m.t2].gf+=r.g2;t[m.t2].ga+=r.g1;
    if(r.g1>r.g2){t[m.t1].w++;t[m.t1].pts+=3;t[m.t2].l++;}
    else if(r.g1<r.g2){t[m.t2].w++;t[m.t2].pts+=3;t[m.t1].l++;}
    else{t[m.t1].d++;t[m.t2].d++;t[m.t1].pts++;t[m.t2].pts++;}
  });
  return Object.entries(t).sort((a,b)=>{
    if(b[1].pts!==a[1].pts)return b[1].pts-a[1].pts;
    const da=a[1].gf-a[1].ga,db=b[1].gf-b[1].ga;
    return db!==da?db-da:b[1].gf-a[1].gf;
  });
}
function complete(g){return GM.filter(m=>m.g===g).every(m=>RES[m.id]);}
function resolve(slot){
  if(F[slot])return slot;
  if(/^[12][A-L]$/.test(slot)){
    const p=parseInt(slot[0])-1,g=slot[1];
    if(!complete(g))return null;
    return stnd(g)[p]?.[0]||null;
  }
  if(slot.startsWith('3rd'))return null;
  if(/^[WL]\d+$/.test(slot)){
    const isW=slot[0]==='W',n=slot.slice(1);
    const km=ALL_KO.find(m=>m.id==='M'+n);
    if(!km||!RES['k'+km.id])return null;
    const r=RES['k'+km.id],t1=resolve(km.t1),t2=resolve(km.t2);
    if(!t1||!t2)return null;
    const w=r.g1>r.g2?t1:(r.g1<r.g2?t2:null);
    const l=r.g1>r.g2?t2:(r.g1<r.g2?t1:null);
    return isW?w:l;
  }
  return null;
}

/* ──── DATE HELPERS ──── */
function tod(){return new Date().toISOString().slice(0,10);}
function offD(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10);}
function wk(off=0){
  const d=new Date(),dy=d.getDay(),tm=dy===0?-6:1-dy;
  const mo=new Date(d);mo.setDate(d.getDate()+tm+off*7);
  const su=new Date(mo);su.setDate(mo.getDate()+6);
  return{s:mo.toISOString().slice(0,10),e:su.toISOString().slice(0,10)};
}
function inPeriod(date){
  switch(period){
    case'yesterday':return date===offD(-1);
    case'today':return date===tod();
    case'tomorrow':return date===offD(1);
    case'thisWeek':{const w=wk(0);return date>=w.s&&date<=w.e;}
    case'nextWeek':{const w=wk(1);return date>=w.s&&date<=w.e;}
    case'thisAndNext':{const w=wk(0),n=wk(1);return date>=w.s&&date<=n.e;}
    default:return true;
  }
}
function fmtD(ds){
  return new Date(ds+'T12:00:00').toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'}).toUpperCase();
}

/* ──── CALENDAR ──── */
function utcStr(date,time,addH=0){
  const[y,m,d]=date.split('-').map(Number),[h,mi]=time.split(':').map(Number);
  const dt=new Date(Date.UTC(y,m-1,d,h-2+addH,mi));
  const p=n=>String(n).padStart(2,'0');
  return`${dt.getUTCFullYear()}${p(dt.getUTCMonth()+1)}${p(dt.getUTCDate())}T${p(dt.getUTCHours())}${p(dt.getUTCMinutes())}00Z`;
}
function gCalUrl(m){
  const s=utcStr(m.d,m.t),e=utcStr(m.d,m.t,2);
  const p=encodeURIComponent;
  const lbl=m.g?`Group ${m.g} · `:'';
  return`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${p(m.t1+' vs '+m.t2+' · WC2026')}&dates=${s}/${e}&details=${p(lbl+m.v)}&location=${p(m.v)}`;
}
function makeIcs(matches){
  const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//WC2026//EN','CALSCALE:GREGORIAN','X-WR-CALNAME:World Cup 2026','X-WR-TIMEZONE:Europe/Stockholm'];
  matches.forEach(m=>L.push(
    'BEGIN:VEVENT',
    'UID:'+m.id+'@wc2026',
    'DTSTART:'+utcStr(m.d,m.t),
    'DTEND:'+utcStr(m.d,m.t,2),
    'SUMMARY:'+m.t1+' vs '+m.t2+' - World Cup 2026',
    'DESCRIPTION:'+(m.g?'Group '+m.g+'\\n':'')+m.v,
    'LOCATION:'+m.v,
    'END:VEVENT'
  ));
  L.push('END:VCALENDAR');
  return L.join('\r\n');
}
function dlIcs(matches,name){
  const blob=new Blob([makeIcs(matches)],{type:'text/calendar;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name||'WC2026.ics';
  document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(a.href);
}
function addToGCal(id){
  const m=GM.find(x=>x.id===id)||ALL_KO.find(x=>x.id===id);
  if(m)window.open(gCalUrl(m),'_blank');
}
function addToIcs(id){
  const m=GM.find(x=>x.id===id)||ALL_KO.find(x=>x.id===id);
  if(m)dlIcs([m],'WC2026_'+id+'.ics');
}
function exportVisible(){
  const tf=document.getElementById('teamFilter').value;
  const gf=document.getElementById('groupFilter').value;
  const vis=GM.filter(m=>inPeriod(m.d)&&(!tf||m.t1===tf||m.t2===tf)&&(!gf||m.g===gf));
  if(!vis.length)return alert('No matches in current filter.');
  dlIcs(vis,'WC2026_export.ics');
}

/* ──── RENDER GROUPS ──── */
function renderGroups(){
  let h='';
  Object.keys(GRP).forEach(g=>{
    const st=stnd(g);
    let rows='';
    st.forEach(([nm,s],i)=>{
      const gd=s.gf-s.ga;
      const gdh=gd>0?`<span class="gdp">+${gd}</span>`:gd<0?`<span class="gdn">${gd}</span>`:'0';
      const cls=i===0?'q1':i===1?'q2':i===2?'q3':'';
      rows+=`<tr class="${cls}"><td><div class="tc"><span class="fl">${F[nm]||''}</span><span class="tn" title="${nm}">${sn(nm)}</span></div></td>
      <td>${s.p}</td><td>${s.w}</td><td>${s.d}</td><td>${s.l}</td><td>${s.gf}</td><td>${s.ga}</td><td>${gdh}</td><td class="pts">${s.pts}</td></tr>`;
    });
    h+=`<div class="gcard"><div class="gcard-hd" data-grp="${g}"><div class="gcard-lbl">Group ${g}</div></div>
    <table class="gtbl"><thead><tr><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>PTS</th></tr></thead><tbody>${rows}</tbody></table></div>`;
  });
  document.getElementById('groupsGrid').innerHTML=h;
}

/* ──── RENDER MATCHES ──── */
function getFiltered(){
  const tf=document.getElementById('teamFilter').value;
  const gf=document.getElementById('groupFilter').value;
  return GM.filter(m=>inPeriod(m.d)&&(!tf||m.t1===tf||m.t2===tf)&&(!gf||m.g===gf))
           .sort((a,b)=>(a.d+a.t).localeCompare(b.d+b.t));
}
function renderMatches(){
  const list=getFiltered();
  const cont=document.getElementById('matchList');
  if(!list.length){cont.innerHTML='<div class="empty">No matches for this filter.</div>';return;}
  const byDate={};list.forEach(m=>{if(!byDate[m.d])byDate[m.d]=[];byDate[m.d].push(m);});
  let h='';
  const td=tod();
  Object.keys(byDate).sort().forEach(date=>{
    const arr=byDate[date];
    h+=`<div class="dh">${fmtD(date)}<span class="dh-count">${arr.length} match${arr.length>1?'es':''}</span></div>`;
    h+='<div class="mday-grid">';
    arr.forEach(m=>{h+=buildCard(m,td);});
    h+='</div>';
  });
  cont.innerHTML=h;
}

function buildCard(m,td){
  const r=RES[m.id],played=!!r,editing=!!editG[m.id];
  const isToday=m.d===td;
  const cls=played?'played':isToday?'today':'';

  let scoreH;
  if(played&&!editing){
    scoreH=`<div class="score-val">${r.g1}<span class="score-sep-d"> – </span>${r.g2}</div>`;
  }else{
    scoreH=`<div class="score-inputs">
      <input class="sin" id="g1_${m.id}" type="number" min="0" max="20" value="${r?r.g1:''}" placeholder="0" onkeydown="if(event.key==='Enter')saveGM('${m.id}')">
      <span class="sin-sep">–</span>
      <input class="sin" id="g2_${m.id}" type="number" min="0" max="20" value="${r?r.g2:''}" placeholder="0" onkeydown="if(event.key==='Enter')saveGM('${m.id}')">
    </div>`;
  }

  const gSvg=`<svg width="11" height="11" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>`;
  const aSvg=`<svg width="11" height="11" viewBox="0 0 24 24" fill="#A2AAAD"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>`;

  const actH=played&&!editing
    ?`<span class="played-s">Played</span><button class="edit-s" onclick="editGM('${m.id}')">Edit</button>`
    :`<button class="save-inline" onclick="saveGM('${m.id}')">Save</button>`;

  return`<div class="mcard ${cls}">
    <div class="mcard-hd">
      <div><div class="mc-grp">GRP ${m.g}</div></div>
      <div style="text-align:right"><div class="mc-time">${m.t}</div><div class="mc-tz">CEST</div></div>
    </div>
    <div class="mcard-body">
      <div class="score-row">
        <div class="team-side"><span class="fl">${F[m.t1]||''}</span><span class="tn2" title="${m.t1}">${sn(m.t1)}</span></div>
        <div class="score-center">${scoreH}</div>
        <div class="team-side r"><span class="tn2" title="${m.t2}">${sn(m.t2)}</span><span class="fl">${F[m.t2]||''}</span></div>
      </div>
    </div>
    <div class="mcard-foot">
      <div class="venue-s" title="${m.v}">${m.v.split(',')[0]}</div>
      <div class="cal-btns">
        ${actH}
        <button class="cbtn gcal" onclick="addToGCal('${m.id}')" title="Add to Google Calendar">${gSvg}</button>
        <button class="cbtn acal" onclick="addToIcs('${m.id}')" title="Add to Apple Calendar">${aSvg}</button>
      </div>
    </div>
  </div>`;
}

function saveGM(id){
  const g1=parseInt(document.getElementById('g1_'+id)?.value);
  const g2=parseInt(document.getElementById('g2_'+id)?.value);
  if(isNaN(g1)||isNaN(g2))return;
  RES[id]={g1,g2};delete editG[id];persist();renderAll();
}
function editGM(id){editG[id]=true;renderMatches();}

/* ──── RENDER KNOCKOUTS ──── */
function renderKnockouts(){
  const rounds=[
    {label:'Round of 32',sub:'28 Jun – 4 Jul 2026 · 16 matches',matches:R32},
    {label:'Round of 16',sub:'4 – 8 Jul 2026 · 8 matches',matches:R16},
    {label:'Quarter-finals',sub:'9 – 12 Jul 2026 · 4 matches',matches:QF},
    {label:'Semi-finals',sub:'14 – 15 Jul 2026 · 2 matches',matches:SF},
    {label:'Third Place',sub:'18 Jul 2026 · Miami',matches:THIRD},
    {label:'Final',sub:'19 Jul 2026 · MetLife Stadium, New Jersey',matches:FINAL},
  ];
  let h='';
  const gSvg=`<svg width="10" height="10" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>`;
  const aSvg=`<svg width="10" height="10" viewBox="0 0 24 24" fill="#A2AAAD"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>`;

  rounds.forEach(({label,sub,matches})=>{
    let cards='';
    matches.forEach(m=>{
      const rk='k'+m.id,r=RES[rk];
      const t1=resolve(m.t1),t2=resolve(m.t2);
      const both=t1&&t2,played=both&&!!r,editing=!!editK[rk];
      const isFinal=m.id==='M104';
      function tr(slot,name,isT1){
        const sc=played?(isT1?r.g1:r.g2):'';
        const hasW=played&&r.g1!==r.g2;
        const isW=played&&(isT1?r.g1>r.g2:r.g2>r.g1);
        const cls=hasW?(isW?'win':'los'):'';
        const th=name?`<span class="fl" style="font-size:16px">${F[name]||''}</span><span>${sn(name)}</span>`:`<span class="ko-slot">${slot}</span>`;
        return`<div class="ko-tr ${cls}"><div class="ko-tl">${th}</div>${played?`<span class="ko-sc">${sc}</span>`:''}</div>`;
      }
      let foot='';
      if(both&&(!played||editing)){
        foot=`<div class="ko-foot">
          <input class="sin" id="k1_${m.id}" type="number" min="0" value="${r?r.g1:''}" placeholder="0" style="width:34px;height:34px;font-size:14px">
          <span class="sin-sep" style="font-size:16px">–</span>
          <input class="sin" id="k2_${m.id}" type="number" min="0" value="${r?r.g2:''}" placeholder="0" style="width:34px;height:34px;font-size:14px">
          <button class="ko-sbtn" onclick="saveKO('${m.id}')">Save</button>
          ${editing?`<button class="ko-ebtn" onclick="cancelKO('${m.id}')">Cancel</button>`:''}
          <button class="cbtn gcal" onclick="addToGCal('${m.id}')" title="Google Cal" style="padding:4px 6px">${gSvg}</button>
          <button class="cbtn acal" onclick="addToIcs('${m.id}')" title="Apple Cal" style="padding:4px 6px">${aSvg}</button>
        </div>`;
      }else if(played&&!editing){
        foot=`<div class="ko-foot">
          <button class="ko-ebtn" onclick="editKO('${m.id}')">Edit</button>
          <button class="cbtn gcal" onclick="addToGCal('${m.id}')" title="Google Cal" style="padding:4px 6px;margin-left:4px">${gSvg}</button>
          <button class="cbtn acal" onclick="addToIcs('${m.id}')" title="Apple Cal" style="padding:4px 6px">${aSvg}</button>
        </div>`;
      }else if(both){
        foot=`<div class="ko-foot">
          <button class="cbtn gcal" onclick="addToGCal('${m.id}')" title="Google Cal" style="padding:4px 6px">${gSvg} Google</button>
          <button class="cbtn acal" onclick="addToIcs('${m.id}')" title="Apple Cal" style="padding:4px 6px">${aSvg} Apple</button>
        </div>`;
      }
      const dl=new Date(m.d+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'});
      cards+=`<div class="kocard${isFinal?' final-card':''}">
        <div class="kocard-hd"><div class="ko-id">${m.id}</div><div class="ko-meta">${dl} · ${m.t} CEST<br>${m.v.split(',')[0]}</div></div>
        <div class="ko-body">${tr(m.t1,t1,true)}${tr(m.t2,t2,false)}</div>${foot}
      </div>`;
    });
    h+=`<div class="ko-rnd"><div class="ko-rnd-hd">${label}<span class="ko-rnd-sub">${sub}</span></div><div class="ko-grid">${cards}</div></div>`;
  });
  document.getElementById('koPanel').innerHTML=h;
}
function saveKO(id){
  const g1=parseInt(document.getElementById('k1_'+id)?.value);
  const g2=parseInt(document.getElementById('k2_'+id)?.value);
  if(isNaN(g1)||isNaN(g2))return;
  RES['kM'+id.slice(1)]={g1,g2};delete editK['kM'+id];persist();renderKnockouts();
}
function editKO(id){editK['kM'+id]=true;renderKnockouts();}
function cancelKO(id){delete editK['kM'+id];renderKnockouts();}

/* ──── TABS / FILTERS ──── */
let atab='groups';
function switchTab(name,el){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  el.classList.add('active');atab=name;
  if(name==='knockouts')renderKnockouts();
}
function setPeriod(el){
  period=el.dataset.p;
  document.querySelectorAll('.pf .pfbtn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');renderMatches();
}
function renderAll(){renderGroups();if(atab==='matches')renderMatches();if(atab==='knockouts')renderKnockouts();}

/* ──── INIT ──── */
function init(){
  const sel=document.getElementById('teamFilter');
  [...new Set(GM.flatMap(m=>[m.t1,m.t2]))].sort().forEach(t=>{
    const o=document.createElement('option');o.value=t;o.textContent=t;sel.appendChild(o);
  });
  load();renderGroups();renderMatches();
}
init();
</script>
</body>
</html>
